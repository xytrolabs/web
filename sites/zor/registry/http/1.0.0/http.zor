// HTTP Package v1.0.0 — basic HTTP via curl

/// Fetches content from a URL using curl.
fun get(url string) string {
    var cmd string = "curl -s " + url + " > /tmp/zor_http_out"
    run_cmd(cmd)
    var result string = read_file("/tmp/zor_http_out")
    give: result
}

/// Posts data to a URL.
fun post(url string, data string) string {
    write_file("/tmp/zor_http_data", data)
    var cmd string = "curl -s -X POST -d @/tmp/zor_http_data " + url + " > /tmp/zor_http_out"
    run_cmd(cmd)
    var result string = read_file("/tmp/zor_http_out")
    give: result
}
