[Unit]
Description=Xytro Vault FUSE Mount
Documentation=https://xytro.site/docs/vault
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=%h/.local/bin/xytro-vault-automount
ExecStop=/bin/fusermount -u /run/media/%u/Vault
Restart=on-failure
RestartSec=10
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
