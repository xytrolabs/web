[Unit]
Description=Valis Cache Engine (llama.cpp)
After=network.target

[Service]
Type=simple
User=raf
ExecStart=/run/media/raf/Z/PrismTechnologies/vllm-server/llama.cpp/build/bin/llama-server \
  --host 0.0.0.0 --port 4006 \
  --model /run/media/raf/Z/PrismTechnologies/vllm-server/qwen2.5-0.5b.gguf \
  --n-gpu-layers 99 --ctx-size 8192 \
  --threads 14 --threads-http 4 \
  --batch-size 2048 --ubatch-size 512 \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  --cont-batching --mlock --no-webui --flash-attn
Restart=always
RestartSec=5
StandardOutput=append:/tmp/llama-server.log
StandardError=append:/tmp/llama-server.log

[Install]
WantedBy=multi-user.target
